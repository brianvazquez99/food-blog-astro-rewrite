---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

export const getStaticPaths = (async () => {
    const blogsPromise = await fetch(
        `https://gold-toad-177179.hostingersite.com/wp-json/wp/v2/posts`,
    );
    const blogsJson = await blogsPromise.json();
    console.log("blogs", blogsJson);
    const paths = await Promise.all(
        blogsJson.map(async (blog: any) => {
            if (blog.featured_media != null) {
                const featuredImagePromise = await fetch(
                    `https://gold-toad-177179.hostingersite.com/wp-json/wp/v2/media/${blog.featured_media}`,
                );
                const featuredImageJson = await featuredImagePromise.json();
                console.log(featuredImageJson.guid?.rendered);
                if (featuredImageJson) {
                    blog["image_url"] = featuredImageJson.guid?.rendered;
                }
            }

            return {
                params: { slug: blog.slug },
                props: {
                    title: blog.title.rendered,
                    content: blog.content.rendered,
                    image_url: blog.image_url,
                    date_published: blog.date,
                    instructions: blog.acf.instructions,
                    ingredients: blog.acf.ingredients,
                    prep_time: blog.acf.prep_time,
                    cook_time: blog.acf.cook_time,
                    slug: blog.slug,
                },
            };
        }),
    );
    console.log("paths", paths);
    return paths.filter((path) => path.props.image_url != null);
}) satisfies GetStaticPaths;

const {
    title,
    content,
    image_url,
    date_published,
    instructions,
    ingredients,
    prep_time,
    cook_time,
    slug,
} = Astro.props;
---

<Layout>
    <meta slot="head" name="description" content={title} />
    <meta slot="head" name="robots" content="index, follow" />
    <link
        slot="head"
        rel="canonical"
        href={"https://mailanhomebakery.com/" + slug}
    />

    <meta slot="head" property="og:title" content={title} />
    <meta slot="head" property="og:description" content={title} />
    <meta slot="head" property="og:image" content={image_url} />
    <meta
        slot="head"
        property="og:url"
        content={"https://mailanhomebakery.com/" + slug}
    />
    <meta slot="head" property="og:type" content="article" />
    <main class="flex flex-col items-center">
        <div class="container mx-auto">
            <article
                class="w-full"
                itemscope
                itemtype="https://schema.org/Article"
            >
                <h1
                    id="title"
                    class="title text-center text-4xl my-3"
                    itemprop="headline"
                    set:html={title}
                />
                <div id="thumbnail" class="flex justify-center">
                    <Image
                        fetchpriority="high"
                        src={image_url}
                        alt={title + " thumbnail"}
                        class="shadow rounded max-w-full h-auto"
                        itemprop="image"
                        height="500"
                        width="500"
                    />
                </div>

                <div class="mt-4 mb-6 flex justify-center">
                    <a
                        href="#recipe"
                        class="inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-[#6E3E6F] bg-[#E4B52E] px-4 py-2.5 font-bold leading-none text-[#2C1A0E] no-underline shadow-[0_3px_0_#6E3E6F] transition-[transform,box-shadow,background-color] duration-75 ease-out hover:-translate-y-px hover:bg-[#EDC54F] hover:shadow-[0_4px_0_#6E3E6F] focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#6E3E6F] motion-reduce:transition-none"
                    >
                        Jump to recipe
                        <svg
                            class="size-4.5 fill-none stroke-current stroke-[2.25] [stroke-linecap:round] [stroke-linejoin:round]"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                        >
                            <path d="m7 10 5 5 5-5M7 5l5 5 5-5" />
                        </svg>
                    </a>
                </div>

                <meta itemprop="datePublished" content={date_published} />

                <div id="body" class="flex flex-col items-center gap-3 p-2">
                    <div
                        class="w-full m-0 p-10 prose prose-lg"
                        itemprop="articleBody"
                    >
                        <Fragment set:html={content} />
                    </div>
                    <section
                        id="recipe"
                        class="recipe-card printable-area"
                        itemscope
                        itemtype="https://schema.org/Recipe"
                        aria-labelledby="recipe-title"
                    >
                        <meta itemprop="image" content={image_url} />

                        <header class="recipe-header">
                            <div class="recipe-heading">
                                <span class="recipe-eyebrow">Recipe</span>
                                <h2
                                    id="recipe-title"
                                    itemprop="name"
                                    set:html={title}
                                />
                            </div>

                            <div class="recipe-toolbar">
                                <dl
                                    class="recipe-times"
                                    aria-label="Recipe timing"
                                >
                                    <div class="time-card">
                                        <span
                                            class="time-icon"
                                            aria-hidden="true"
                                        >
                                            <svg viewBox="0 0 24 24">
                                                <circle cx="12" cy="13" r="8" />
                                                <path d="M12 9v4l2.5 1.5M9 3h6" />
                                            </svg>
                                        </span>
                                        <div>
                                            <dt>Prep time</dt>
                                            <dd set:html={prep_time} />
                                        </div>
                                    </div>
                                    <div class="time-card">
                                        <span
                                            class="time-icon"
                                            aria-hidden="true"
                                        >
                                            <svg viewBox="0 0 24 24">
                                                <path d="M7 20h10M8 17h8M12 3c2 3-1 4 1 7 1.5 2 4 1.5 4 5a5 5 0 0 1-10 0c0-2 1-3.5 3-5-.25 2 1 3 2 3 2-2-1-5 0-10Z" />
                                            </svg>
                                        </span>
                                        <div>
                                            <dt>Cook time</dt>
                                            <dd set:html={cook_time} />
                                        </div>
                                    </div>
                                </dl>

                                <button
                                    class="print-button"
                                    type="button"
                                    data-print-recipe
                                >
                                    <svg aria-hidden="true" viewBox="0 0 24 24">
                                        <path d="M7 8V4h10v4M7 17H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                                        <path d="M7 14h10v6H7z" />
                                    </svg>
                                    Print recipe
                                </button>
                            </div>
                        </header>

                        <div class="recipe-grid">
                            <section
                                class="recipe-panel ingredients-panel"
                                aria-labelledby="ingredients-title"
                            >
                                <div class="section-heading">
                                    <span
                                        class="section-number"
                                        aria-hidden="true"
                                    >
                                        1
                                    </span>
                                    <div>
                                        <h3 id="ingredients-title">
                                            Ingredients
                                        </h3>
                                        <p>
                                            Gather everything before you begin.
                                        </p>
                                    </div>
                                </div>
                                <div
                                    class="recipe-content ingredients-content"
                                    set:html={ingredients}
                                />
                            </section>

                            <section
                                class="recipe-panel instructions-panel"
                                aria-labelledby="instructions-title"
                            >
                                <div class="section-heading">
                                    <span
                                        class="section-number"
                                        aria-hidden="true"
                                    >
                                        2
                                    </span>
                                    <div>
                                        <h3 id="instructions-title">
                                            Instructions
                                        </h3>
                                        <p>
                                            Follow each step in order for the
                                            best result.
                                        </p>
                                    </div>
                                </div>
                                <div
                                    class="recipe-content instructions-content"
                                    itemprop="recipeInstructions"
                                    set:html={instructions}
                                />
                            </section>
                        </div>
                    </section>
                </div>
            </article>
        </div>
    </main>
</Layout>

<script>
    document.querySelectorAll("[data-print-recipe]").forEach((button) => {
        button.addEventListener("click", () => window.print());
    });
</script>

<style>
    .print-button:focus-visible {
        outline: 3px solid #6e3e6f;
        outline-offset: 3px;
    }

    .recipe-card {
        width: 100%;
        max-width: 72rem;
        scroll-margin-top: 1.5rem;
        overflow: hidden;
        border: 1px solid rgb(110 62 111 / 22%);
        border-radius: 1.25rem;
        background: #fffdf8;
        color: #2c1a0e;
        box-shadow: 0 18px 45px rgb(44 26 14 / 12%);
    }

    .recipe-header {
        position: relative;
        display: grid;
        gap: 1.5rem;
        overflow: hidden;
        border-bottom: 1px solid rgb(44 26 14 / 15%);
        background: linear-gradient(135deg, #e4b52e 0%, #f0cd65 100%);
        padding: clamp(1.5rem, 4vw, 2.75rem);
    }

    .recipe-header::after {
        position: absolute;
        right: -3rem;
        bottom: -5rem;
        width: 13rem;
        height: 13rem;
        border: 2rem solid rgb(255 255 255 / 18%);
        border-radius: 50%;
        content: "";
        pointer-events: none;
    }

    .recipe-heading,
    .recipe-toolbar {
        position: relative;
        z-index: 1;
    }

    .recipe-eyebrow {
        display: inline-block;
        margin-bottom: 0.5rem;
        color: #6e3e6f;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .recipe-heading h2 {
        max-width: 48rem;
        margin: 0;
        color: #2c1a0e;
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        font-weight: 800;
        line-height: 1.15;
        text-wrap: balance;
    }

    .recipe-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: space-between;
        gap: 1rem;
    }

    .recipe-times {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin: 0;
    }

    .time-card {
        display: flex;
        min-width: 9.5rem;
        align-items: center;
        gap: 0.75rem;
        border: 1px solid rgb(44 26 14 / 14%);
        border-radius: 0.875rem;
        background: rgb(255 253 248 / 78%);
        padding: 0.75rem 0.875rem;
    }

    .time-icon {
        display: grid;
        width: 2.25rem;
        height: 2.25rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 50%;
        background: #6e3e6f;
        color: white;
    }

    .time-icon svg {
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .time-card dt {
        color: #6b5849;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .time-card dd {
        margin: 0.15rem 0 0;
        color: #2c1a0e;
        font-size: 0.95rem;
        font-weight: 800;
        line-height: 1.25;
    }

    .print-button {
        display: inline-flex;
        min-height: 3.25rem;
        align-items: center;
        justify-content: center;
        align-self: center;
        gap: 0.625rem;
        border: 2px solid #6e3e6f;
        border-radius: 0.875rem;
        background: #6e3e6f;
        padding: 0.75rem 1.125rem;
        color: white;
        font: inherit;
        font-weight: 750;
        line-height: 1;
        cursor: pointer;
        transition:
            background-color 150ms ease,
            color 150ms ease,
            transform 150ms ease;
    }

    .print-button:hover {
        background: #fffdf8;
        color: #6e3e6f;
        transform: translateY(-1px);
    }

    .print-button svg {
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .recipe-grid {
        display: grid;
        grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.35fr);
    }

    .recipe-panel {
        min-width: 0;
        padding: clamp(1.5rem, 4vw, 2.75rem);
    }

    .ingredients-panel {
        border-right: 1px solid rgb(110 62 111 / 16%);
        background: #f8f0f6;
    }

    .instructions-panel {
        background: #fffdf8;
    }

    .section-heading {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid rgb(110 62 111 / 18%);
    }

    .section-number {
        display: grid;
        width: 2rem;
        height: 2rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 50%;
        background: #e4b52e;
        color: #2c1a0e;
        font-size: 0.875rem;
        font-weight: 800;
    }

    .section-heading h3 {
        margin: 0;
        color: #2c1a0e;
        font-size: clamp(1.35rem, 3vw, 1.75rem);
        font-weight: 800;
        line-height: 1.15;
    }

    .section-heading p {
        margin: 0.35rem 0 0;
        color: #735f50;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .recipe-content {
        color: #3d2b20;
        font-size: 1rem;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    .recipe-content :global(ul),
    .recipe-content :global(ol) {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .recipe-content :global(p),
    .recipe-content :global(li) {
        margin: 0;
    }

    .recipe-content :global(p + p) {
        margin-top: 1rem;
    }

    .recipe-content :global(h1),
    .recipe-content :global(h2),
    .recipe-content :global(h3),
    .recipe-content :global(h4) {
        margin: 1.5rem 0 0.75rem;
        color: #2c1a0e;
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.35;
    }

    .recipe-content :global(strong) {
        color: #2c1a0e;
        font-weight: 750;
    }

    .ingredients-content :global(li) {
        position: relative;
        padding: 0.7rem 0 0.7rem 1.75rem;
        border-bottom: 1px solid rgb(110 62 111 / 12%);
    }

    .ingredients-content :global(li:last-child) {
        border-bottom: 0;
    }

    .ingredients-content :global(li::before) {
        position: absolute;
        top: 1.25rem;
        left: 0.25rem;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #e4b52e;
        box-shadow: 0 0 0 3px rgb(228 181 46 / 22%);
        content: "";
    }

    .instructions-content :global(ol) {
        counter-reset: recipe-step;
    }

    .instructions-content :global(ol > li) {
        position: relative;
        min-height: 2.5rem;
        padding: 0 0 1.5rem 3.25rem;
        counter-increment: recipe-step;
    }

    .instructions-content :global(ol > li + li) {
        padding-top: 1.5rem;
        border-top: 1px solid rgb(44 26 14 / 12%);
    }

    .instructions-content :global(ol > li::before) {
        position: absolute;
        top: 0;
        left: 0;
        display: grid;
        width: 2.25rem;
        height: 2.25rem;
        place-items: center;
        border-radius: 50%;
        background: #6e3e6f;
        color: white;
        content: counter(recipe-step);
        font-size: 0.875rem;
        font-weight: 800;
    }

    .instructions-content :global(ol > li + li::before) {
        top: 1.5rem;
    }

    .instructions-content :global(ul) {
        margin: 0.75rem 0;
        padding-left: 1.25rem;
        list-style: disc;
    }

    @media (max-width: 767px) {
        .recipe-card {
            border-radius: 1rem;
        }

        .recipe-toolbar,
        .print-button {
            width: 100%;
        }

        .recipe-times {
            width: 100%;
        }

        .time-card {
            min-width: 0;
            padding: 0.7rem;
        }

        .recipe-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .ingredients-panel {
            border-right: 0;
            border-bottom: 1px solid rgb(110 62 111 / 16%);
        }
    }

    @media (max-width: 420px) {
        .recipe-times {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .print-button {
            transition: none;
        }
    }

    @media print {
        :global(body *) {
            visibility: hidden !important;
        }

        .printable-area,
        .printable-area :global(*) {
            visibility: visible !important;
        }

        .printable-area {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            max-width: none;
            overflow: visible;
            border: 0;
            border-radius: 0;
            background: white;
            box-shadow: none;
        }

        .recipe-header {
            display: block;
            border-bottom: 2px solid #2c1a0e;
            background: white;
            padding: 0 0 1rem;
        }

        .recipe-header::after,
        .print-button,
        .section-heading p {
            display: none;
        }

        .recipe-eyebrow {
            color: #2c1a0e;
        }

        .recipe-toolbar {
            margin-top: 1rem;
        }

        .time-card {
            border-color: #999;
            background: white;
        }

        .time-icon {
            border: 1px solid #2c1a0e;
            background: white;
            color: #2c1a0e;
        }

        .recipe-grid {
            grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1.4fr);
        }

        .recipe-panel {
            padding: 1.25rem 1rem;
        }

        .ingredients-panel,
        .instructions-panel {
            background: white;
        }

        .ingredients-panel {
            border-right-color: #999;
        }

        .recipe-content {
            font-size: 10pt;
            line-height: 1.45;
        }

        .section-heading,
        .recipe-content :global(li),
        .recipe-content :global(p) {
            break-inside: avoid;
        }

        .instructions-content :global(ol > li) {
            padding-bottom: 0.9rem;
        }

        .instructions-content :global(ol > li + li) {
            padding-top: 0.9rem;
        }

        .instructions-content :global(ol > li + li::before) {
            top: 0.9rem;
        }
    }
</style>
